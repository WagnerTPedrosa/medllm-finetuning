# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/

# Virtual environments and local secrets
.venv/
venv/
.env
.env.*
!.env.example
/.aws/

# Notebook and tool caches
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated model checkpoints
/checkpoints/
/mlruns/
/mlflow.db*

# Operating system files
.DS_Store
Thumbs.db

# Hugging Face datasets caches
data/processed/**/cache-*.arrow

# Raw downloads and intermediate data (rebuilt by pipelines/data/dvc.yaml)
data/raw/
data/interim/

# Tokenized pretraining corpus (several GB, rebuilt by src/corpus.py)
data/processed/pubmed_*/

# Multitask fine-tuning data (rebuilt by src/multitask.py)
data/processed/multitask_*/

# Training logs (metrics and curves are tracked in MLflow)
*.log
